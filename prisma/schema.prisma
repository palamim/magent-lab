// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lab/records/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentType {
  planner
  executor
  director
  architect
}

enum CriterionCategory {
  PROJECT_CONVENTIONS
  FUNCTIONAL_CORRECTNESS
  CODE_QUALITY
  SAFETY_SECURITY
  TESTING_DOCUMENTATION
}

model JudgeRun {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  experimentId String
  subjectKey   String // which judge config
  diffKey      String // which labeled diff
  model        String
  latencyMs    Int
  allMatched   Boolean // did every criterion match ground truth?
  agreements   Json // [{ criterion, expected, actual, matched }]

  @@index([experimentId])
  @@index([subjectKey])
  @@index([diffKey])
}

model AgentRun {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  agentType     AgentType
  model         String
  prompt        String
  steps         Int
  toolCalls     Int
  readFileCalls Int
  filesRead     String[]
  inputTokens   Int
  outputTokens  Int
  latencyMs     Int
  purpose       String
  repoKey       String
  costUsd       Decimal   @db.Decimal(10, 6)

  //output
  output Json

  @@index([agentType])
}

/**
 * EXPERIMENT: the orchestrator of evaluations (decides which combinations, how many times)
 */
model Experiment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  description String
}
